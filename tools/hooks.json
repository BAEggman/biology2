{
  "_왜": "확정된 음성 후크 사전. audit_phonetics.js가 이것을 읽어 「이 라벨은 이 소품이 나른다」를 인정한다. 여기 없으면 감사가 위반으로 센다 — 그래서 후크를 넣을 때마다 여기에 적어야 숫자가 실제로 줄어든다.",
  "_형태": "① 소리(소품 이름이 라벨처럼 들린다) ② 글자 모양(소품 생김새가 그 글자다) ③ 머리글자 낱말(소품 이름의 첫 글자가 라벨이다)",
  "hooks": {
    "Rb":      {"props": ["루비"], "형태": "①", "왜": "Rb는 원소기호로 루비듐"},
    "E2F":     {"props": ["숫자 2", "F자"], "형태": "②", "왜": "조끼의 2와 F자로 꺾인 장대"},
    "MPF":     {"props": ["앰프"], "형태": "①", "왜": "엠피에프 ≈ 앰프"},
    "Cdk1":    {"props": ["음반"], "형태": "②", "왜": "CD 한 장"},
    "Cdk":     {"props": ["음반"], "형태": "②", "왜": "CD"},
    "Cdc25":   {"props": ["음반"], "형태": "②", "왜": "Cdk와 같은 Cd- 계열, 여러 장으로 가른다"},
    "마이스너":  {"props": ["마이크"], "형태": "①", "왜": "마이"},
    "메르켈":   {"props": ["메달"], "형태": "①", "왜": "메 + 납작한 원반이라 형태까지 같다"},
    "파치니":   {"props": ["양파"], "형태": "①", "왜": "파 + 겹겹 층"},
    "루피니":   {"props": ["루프"], "형태": "①", "왜": "루 + 늘어나는 것이 곧 기능"},
    "Salt":    {"props": ["소금"], "형태": "③", "왜": "Salt"},
    "Sugar":   {"props": ["케이크", "설탕"], "형태": "③", "왜": "Sugar"},
    "Sex":     {"props": ["하트"], "형태": "③", "왜": "Sex"},
    "MutS":    {"props": ["돋보기"], "형태": "③", "왜": "S = Search"},
    "MutL":    {"props": ["사슬"], "형태": "③", "왜": "L = Link"},
    "CC":      {"props": ["편자 둘이 딱 붙"], "형태": "②", "왜": "C 둘이 붙었다"},
    "CXC":     {"props": ["편자 둘 사이에 X"], "형태": "②", "왜": "C와 C 사이에 X"},
    "AQP1":    {"props": ["물이 뿜어"], "형태": "③", "왜": "아쿠아포린 = 물 통로"},
    "H1":      {"props": ["집게 하나", "밖에 있"], "형태": "②", "왜": "코어 밖에 하나"},
    "α":       {"props": ["알", "노른자"], "형태": "①", "왜": "알파 → 알"},
    "β":       {"props": ["베", "무명천"], "형태": "①", "왜": "베타 → 베"}
  }
}
